# /etc/stellar/gateway.env — the lake gateway's root keys, owned as by
#   install -m 0640 -o root -g stellar gateway.env /etc/stellar/gateway.env
# lab galexie (step config) generates it once: exactly these three lines,
# without the comments, with an access key of 10 random bytes and a secret
# key of 32, in hex. Values are unquoted (docker keeps quotes literally).
# Galexie's container reads it with `docker --env-file`; the lake, ingest and
# the launcher parse it by path (it is never loaded into a worker process
# environment).
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
AWS_EC2_METADATA_DISABLED=true
