# /etc/stellar/archive-aws.env — the uploader key under AWS_* names, used
# only by the gap check's detect-gaps container (and a manual archive
# repair). lab galexie (step config) installs it with the entered key, as
#   install -m 0600 -o root -g root archive-aws.env /etc/stellar/archive-aws.env
# Root-only: nothing else reads it. Same key as archive.env.
AWS_ACCESS_KEY_ID=REPLACE_WITH_UPLOADER_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_UPLOADER_SECRET_KEY
AWS_EC2_METADATA_DISABLED=true
