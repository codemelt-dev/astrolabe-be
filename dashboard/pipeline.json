{
  "uid": "stellar-pipeline",
  "title": "Stellar explorer: pipeline",
  "description": "The galexie host: Galexie, the lake, ingest, the archive (lab psql, step grafana).",
  "tags": [
    "stellar-explorer"
  ],
  "editable": false,
  "timezone": "utc",
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Ledgers",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Network tip",
      "description": "The newest ledger ingest knows of: the AWS public lake's (read every 5 s, about a ledger behind) or the lake's, whichever is higher.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(stellar_network_tip{job=\"ingest\"}) > max(ingest_lake_tip{job=\"ingest\"}) or max(ingest_lake_tip{job=\"ingest\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Ingest cursor",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ingest_cursor{job=\"ingest\", pipeline=\"explorer\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Ingest lag (ledgers)",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min((max(stellar_network_tip{job=\"ingest\"}) > max(ingest_lake_tip{job=\"ingest\"}) or max(ingest_lake_tip{job=\"ingest\"})) - max(ingest_cursor{job=\"ingest\", pipeline=\"explorer\"}), 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Network tip minus the ingest cursor, both from the same scrape of ingest, never below 0. ~5 s per ledger; alerts above 120.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Archive lag (ledgers)",
      "description": "The lake tip minus the archive tip, both as ingest sees them, never below 0.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(max(ingest_lake_tip{job=\"ingest\"}) - max(archive_tip), 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Distance behind the network tip",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min((max(stellar_network_tip{job=\"ingest\"}) > max(ingest_lake_tip{job=\"ingest\"}) or max(ingest_lake_tip{job=\"ingest\"})) - max(galexie_uploader_latest_ledger > 0), 0)",
          "legendFormat": "Galexie upload"
        },
        {
          "refId": "B",
          "expr": "clamp_min((max(stellar_network_tip{job=\"ingest\"}) > max(ingest_lake_tip{job=\"ingest\"}) or max(ingest_lake_tip{job=\"ingest\"})) - max(ingest_lake_tip{job=\"ingest\"}), 0)",
          "legendFormat": "lake"
        },
        {
          "refId": "C",
          "expr": "clamp_min((max(stellar_network_tip{job=\"ingest\"}) > max(ingest_lake_tip{job=\"ingest\"}) or max(ingest_lake_tip{job=\"ingest\"})) - max(ingest_cursor{job=\"ingest\", pipeline=\"explorer\"}), 0)",
          "legendFormat": "ingest"
        },
        {
          "refId": "D",
          "expr": "clamp_min((max(stellar_network_tip{job=\"ingest\"}) > max(ingest_lake_tip{job=\"ingest\"}) or max(ingest_lake_tip{job=\"ingest\"})) - max(archive_tip), 0)",
          "legendFormat": "archive"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Ledgers committed per second",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ingest_ledgers_committed_total{job=\"ingest\"}[5m]))",
          "legendFormat": "committed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ingest_ledgers_read_total{job=\"ingest\"}[5m]))",
          "legendFormat": "read"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ledgers/s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Ingest",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ledger latency (lake commit \u2192 Postgres commit)",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ingest_ledger_latency_seconds_bucket{job=\"ingest\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(ingest_ledger_latency_seconds_bucket{job=\"ingest\"}[5m])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ingest_ledger_latency_seconds_bucket{job=\"ingest\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Postgres commit duration",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ingest_commit_duration_seconds_bucket{job=\"ingest\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ingest_commit_duration_seconds_bucket{job=\"ingest\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pipeline alerts (per 15 min)",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(stellar_alerts_total{job=\"ingest\"}[15m]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Scrape targets up",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"lake|ingest|galexie\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Lake and Galexie",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Lake PUT and fsync (p99)",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(lake_put_duration_seconds_bucket[5m])))",
          "legendFormat": "PUT"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(lake_fsync_duration_seconds_bucket[5m])))",
          "legendFormat": "fsync"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Disk used",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(lake_disk_bytes{kind=\"used\"}) / max(lake_disk_bytes{kind=\"size\"})",
          "legendFormat": "/srv/lake"
        },
        {
          "refId": "B",
          "expr": "max(stellar_disk_bytes{job=\"ingest\", mount=\"core\",kind=\"used\"}) / max(stellar_disk_bytes{job=\"ingest\", mount=\"core\",kind=\"size\"})",
          "legendFormat": "/srv/core"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Alerts at 70 % and 85 %.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Galexie and watchdog restarts (per hour)",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(increase(galexie_systemd_restarts[1h]))",
          "legendFormat": "Galexie (systemd)"
        },
        {
          "refId": "B",
          "expr": "max(increase(watchdog_restarts_total[1h]))",
          "legendFormat": "by the watchdog"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pruned lake objects (per hour)",
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(prune_deleted_total[1h]))",
          "legendFormat": "deleted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
