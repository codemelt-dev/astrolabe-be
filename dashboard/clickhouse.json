{
  "uid": "stellar-clickhouse",
  "title": "Stellar explorer: ClickHouse",
  "description": "The clickhouse host: its pipeline, ClickHouse itself, and the history it holds (lab psql, step grafana, when clickhouse_hostname is set).",
  "tags": [
    "stellar-explorer"
  ],
  "editable": false,
  "timezone": "utc",
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Pipeline and server",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Cursor",
      "description": "The last ledger the clickhouse pipeline committed.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ingest_cursor{job=\"clickhouse_ingest\", pipeline=\"clickhouse\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Lag (ledgers)",
      "description": "The AWS public lake's tip, the pipeline's source, minus the cursor, both from one scrape of the pipeline; never below 0.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min((max(stellar_network_tip{job=\"clickhouse_ingest\"}) > max(ingest_lake_tip{job=\"clickhouse_ingest\"}) or max(ingest_lake_tip{job=\"clickhouse_ingest\"})) - max(ingest_cursor{job=\"clickhouse_ingest\", pipeline=\"clickhouse\"}), 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Queries running",
      "description": "Queries ClickHouse is running now: the pipeline, Grafana and the public endpoint.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ClickHouseMetrics_Query{job=\"clickhouse\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Disk used",
      "description": "The clickhouse host's disk; alerts at 70 % and 85 %.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - max(node_filesystem_avail_bytes{job=\"clickhouse_node\", mountpoint=\"/\"}) / max(node_filesystem_size_bytes{job=\"clickhouse_node\", mountpoint=\"/\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Ledgers committed per second",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ingest_ledgers_committed_total{job=\"clickhouse_ingest\"}[5m]))",
          "legendFormat": "committed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ingest_ledgers_read_total{job=\"clickhouse_ingest\"}[5m]))",
          "legendFormat": "read"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ledgers/s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Queries per second",
      "description": "All of ClickHouse's queries: the pipeline's inserts, Grafana and the public endpoint.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ClickHouseProfileEvents_Query{job=\"clickhouse\"}[5m]))",
          "legendFormat": "queries"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ClickHouseProfileEvents_FailedQuery{job=\"clickhouse\"}[5m]))",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ClickHouseMetrics_MemoryTracking{job=\"clickhouse\"})",
          "legendFormat": "ClickHouse"
        },
        {
          "refId": "B",
          "expr": "max(node_memory_MemAvailable_bytes{job=\"clickhouse_node\"})",
          "legendFormat": "available on the host"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Active parts (most in one partition)",
      "description": "Inserts outpacing merges show here first; alert above 300.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ClickHouseAsyncMetrics_MaxPartCountForPartition{job=\"clickhouse\"})",
          "legendFormat": "parts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "History (from ClickHouse)",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Transactions per hour",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfHour(closed_at) AS time, countIf(successful) AS succeeded, countIf(NOT successful) AS failed\nFROM stellar.transactions WHERE $__timeFilter(closed_at)\nGROUP BY time ORDER BY time",
          "queryType": "timeseries",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Fees per hour (XLM)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfHour(closed_at) AS time, sum(fee_charged) / 1e7 AS fees\nFROM stellar.transactions WHERE $__timeFilter(closed_at)\nGROUP BY time ORDER BY time",
          "queryType": "timeseries",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Token transfers per hour, by kind",
      "description": "The SDK's token transfer events: transfer, mint, burn, clawback and fee (refunds count as fee).",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfHour(closed_at) AS time, kind, count() AS transfers\nFROM stellar.token_transfers WHERE $__timeFilter(closed_at)\nGROUP BY time, kind ORDER BY time",
          "queryType": "timeseries",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "${__field.labels.kind}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "table",
      "title": "Operations by type",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT type_name AS type, count() AS operations, countIf(successful) AS succeeded\nFROM stellar.operations WHERE $__timeFilter(closed_at)\nGROUP BY type ORDER BY operations DESC",
          "queryType": "table",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "table",
      "title": "Most transferred tokens",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT if(asset = '', contract_id, asset) AS token, count() AS transfers, uniqExact(from_address) AS senders\nFROM stellar.token_transfers WHERE $__timeFilter(closed_at) AND kind = 'transfer'\nGROUP BY token ORDER BY transfers DESC LIMIT 15",
          "queryType": "table",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "table",
      "title": "Busiest contracts (events)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT contract_id, count() AS events, uniqExact(ledger_sequence, tx_index) AS transactions\nFROM stellar.events WHERE $__timeFilter(closed_at) AND stage = 'operation' AND contract_id != ''\nGROUP BY contract_id ORDER BY events DESC LIMIT 15",
          "queryType": "table",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
