# /etc/stellar/archive.env — the archive bucket's endpoint and the uploader
# key (galexie/README.md §3b). lab galexie (step config) installs it with
# the entered key, as
#   install -m 0640 -o root -g stellar archive.env /etc/stellar/archive.env
# ingest (archiver, sequencer) and the launcher parse it by path. Never use
# AWS_* names here: nothing that reads the AWS credential chain uses it.
ARCHIVE_S3_ENDPOINT=https://hel1.your-objectstorage.com
ARCHIVE_S3_REGION=hel1
ARCHIVE_S3_ACCESS_KEY=REPLACE_WITH_UPLOADER_ACCESS_KEY
ARCHIVE_S3_SECRET_KEY=REPLACE_WITH_UPLOADER_SECRET_KEY
