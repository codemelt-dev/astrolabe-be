# /etc/stellar/archive.env (lab clickhouse, step config): the archive bucket's endpoint and a key
# that can read it, the galexie host's (galexie/README.md §3b). worker clickhouse-ingest and
# clickhouse-init parse it by path to read the archive. Never use AWS_* names here: nothing that
# reads the AWS credential chain uses it.
ARCHIVE_S3_ENDPOINT=https://hel1.your-objectstorage.com
ARCHIVE_S3_REGION=hel1
ARCHIVE_S3_ACCESS_KEY=REPLACE_WITH_UPLOADER_ACCESS_KEY
ARCHIVE_S3_SECRET_KEY=REPLACE_WITH_UPLOADER_SECRET_KEY
